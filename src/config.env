# RastaConverter Dependency Configuration
# This file specifies the paths to external dependencies
# CMake will automatically read this file and use these paths

# FreeImage library path
# Should contain FreeImage.h and the library files
FREEIMAGE_DIR=d:\Projekty\FreeImage\Dist\x64

# SDL3 library path
# Should contain include/ and lib/ subdirectories
SDL3_DIR=d:\Projekty\SDL3

# SDL3_ttf library path
# Should contain include/ and lib/ subdirectories
SDL3_TTF_DIR=d:\Projekty\SDL3_ttf

# Notes:
# - Use forward slashes (/) or double backslashes (\\) in paths
# - Quotes around paths are optional but recommended for paths with spaces
# - CMake will look for headers and libraries in standard subdirectories:
#   * include/ for headers
#   * lib/x64/ or lib/x86/ for libraries (based on target architecture)
#   * Dist/x64/ (for FreeImage specifically)

# Example alternative paths:
# FREEIMAGE_DIR="C:/Program Files/FreeImage"
# SDL3_DIR="C:/SDL3"
# SDL3_TTF_DIR="C:/SDL3_ttf"
