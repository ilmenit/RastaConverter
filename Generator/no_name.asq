/***************************************/
/*  Use MADS http://mads.atari8.info/  */
/*  Mode: GED- (bitmap mode)           */
/***************************************/

	icl "no_name.h"
	icl "output.png.opt.h"

	.ifdef PIC_WIDTH
	.else
* Headers produced before playfield selection existed are normal ANTIC E.
PIC_WIDTH = 160
PLAYFIELD_WIDE = 0
PIC_ROW_BYTES = 40
	eif

	org $00

fcnt	.ds 2
fadr	.ds 2
fhlp	.ds 2
cloc	.ds 1
regA	.ds 1
regX	.ds 1
regY	.ds 1
byt2	.ds 1

zc	.ds ZCOLORS

* ---	BASIC switch OFF
	org $2000\ mva #$ff portb\ rts\ ini $2000

* ---	MAIN PROGRAM
	org $2010
* Store every source row in a 64-byte slot. This keeps both 40-byte normal
* rows and 48-byte wide DMA rows from crossing ANTIC's 4 KiB scan counter.
SCREEN_STRIDE = 64
scr
	.rept PIC_HEIGHT
	IFT PLAYFIELD_WIDE=1
		:3 .byte 0
		ins "output.png.mic", #*PIC_ROW_BYTES, PIC_ROW_BYTES
		:3 .byte 0
		:16 .byte 0
	ELS
		ins "output.png.mic", #*PIC_ROW_BYTES, PIC_ROW_BYTES
		:SCREEN_STRIDE-PIC_ROW_BYTES .byte 0
	eif
	.endr
	.ifdef nil_used
nil	:8*PIC_ROW_BYTES brk
	eif

	.ALIGN $0400
ant	ANTIC_PROGRAM scr,ant

fnt

	ift USESPRITES
	.ALIGN $0800
	.ds $0300
pmg	SPRITES
	eif

main
* ---	init PMG

	ift USESPRITES
	mva >pmg pmbase		;missiles and players data address
	IFT PLAYFIELD_WIDE=1
	mva #$02 pmcntl		;enable players
	ELS
	mva #$03 pmcntl		;enable players and missiles
	eif
	eif

	lda:cmp:req $14		;wait 1 frame

	sei			;stop interrups
	mva #$00 nmien		;stop all interrupts
	mva #$fe portb		;switch off ROM to get 16k more ram

	ZPINIT

////////////////////
// RASTER PROGRAM //
////////////////////

;	jmp line239
	jmp raster_program_end

LOOP	lda vcount		;synchronization for the first screen line
	cmp #$02
	bne LOOP

	IFT PLAYFIELD_WIDE=1
	mva #%00111111 dmactl	;wide playfield
	ELS
	mva #%00111110 dmactl	;normal playfield
	eif
	mva <ant dlptr
	mva >ant dlptr+1

  icl "output.png.opt.ini"

;--- wait 18 cycles
	jsr _rts
	inc byt3

;--- set global offset (23 cycles)
	jsr _rts
	cmp byt3\ pha:pla

;--- empty line
	jsr wait54cycle
	inc byt2

  icl "output.png.opt"

raster_program_end

* Blank the playfield before anything else. This runs during the scanline
* right after the last picture line, so every cycle spent ahead of it is a
* cycle of that line drawn in the colours the picture ended on. Getting all
* five registers written inside horizontal blank is what keeps the border
* clean; CHBASE can wait, since it only matters again at the next frame.
c0	lda #$00
	sta colbak
c1	lda #$00
	sta color0
c2	lda #$00
	sta color1
c3	lda #$00
	sta color2
c4	lda #$00
	sta color3

	lda >fnt+$400*$00
	sta chbase
s0	lda #$03
	sta sizep0
	sta sizep1
	sta sizep2
	sta sizep3
	mva #$ff sizem
	IFT PLAYFIELD_WIDE=1
	mva #$02 pmcntl
	ELS
	mva #$00 grafm
	mva #$cc hposm2
	mva #$28 hposm3
	mva #$f0 sizem
	mva #$03 pmcntl
	eif
	lda #$14
	sta gtictl


//--------------------
//	EXIT
//--------------------

	lda trig0		; FIRE #0
	beq stop

	lda trig1		; FIRE #1
	beq stop

	lda consol		; START
	and #1
	beq stop

	lda skctl		; ANY KEY
	and #$04
	bne skp

stop	mva #$00 pmcntl		;PMG disabled
	tax
	sta:rne hposp0,x+

	mva #$ff portb		;ROM switch on
	mva #$40 nmien		;only NMI interrupts, DLI disabled
	cli			;IRQ enabled

	rts			;return to ... DOS
skp

//--------------------

	jmp LOOP

;---

wait54cycle
	:2 inc byt2
wait44cycle
	inc byt3
	nop
wait36cycle
	inc byt3
	jsr _rts
wait18cycle
	inc byt3
_rts	rts

byt3	brk


;---

.MACRO	ANTIC_PROGRAM
* One mode-E line per picture scanline, then jump back to the top.
*
* This list used to be a fixed 240 lines whatever PIC_HEIGHT was. For a shorter
* picture ANTIC went on fetching playfield past the end of the picture data -
* through the display list itself and into the font and PMG area - and drew
* those bytes for the remaining scanlines. They only looked like a black border
* because the frame epilogue happens to zero all four playfield colour
* registers before the first of them becomes visible, which is timing luck
* rather than a design. Anything that upsets that timing shows the fetched
* memory as a band of garbage under the picture.
	.rept PIC_HEIGHT
	dta $4e,a(:1+#*SCREEN_STRIDE)
	.endr
	dta $41,a(:2)
.ENDM

CL

.MACRO	ZPINIT
.ENDM

ZCOLORS	= 0

;---
	run main
;---

	opt l-

.MACRO	SPRITES
	icl "output.png.pmg"
.ENDM

USESPRITES = 1
