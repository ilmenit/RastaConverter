{
  "name": "rasta-converter",
  "version-string": "1.0-RC12",
  "dependencies": [
    "freeimage",
    {
      "name": "sdl3",
      "default-features": false
    },
    "sdl3-ttf"
  ],
  "features": {
    "linux-desktop": {
      "description": "Build SDL3 with the Linux X11 and Wayland backends",
      "supports": "linux",
      "dependencies": [
        {
          "name": "sdl3",
          "default-features": false,
          "features": [
            "wayland",
            "x11"
          ]
        }
      ]
    }
  }
}
